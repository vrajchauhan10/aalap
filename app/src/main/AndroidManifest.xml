<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Keeps the processor and Wi-Fi awake while music plays with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The mic button: Aalap listens once, only while you ask for a song. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- "Hey Aalap" (off by default): listens while Aalap is open or its music plays. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- "Hey Aalap" outside the app: the voice card over other apps (you allow it in Settings). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Exporting downloads to public Music/ on API <=28 (MediaStore needs none on 29+). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <queries>
        <intent><action android:name="android.speech.RecognitionService"/></intent>
    </queries>

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/splashScreenTheme"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/splashScreenTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the app icon: "Ask Aalap". -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- Voice assistants (Google Assistant, Gemini, Bixby): "play Kesariya on Aalap". -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- aalap://play?q=… for Routines, Modes and shortcuts (not openable from web pages). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="aalap" android:host="play" />
            </intent-filter>
            <!-- A friend's Blend code: Share → Aalap. -->
            <intent-filter android:label="Blend on Aalap">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>

        <!-- Shares generated images (lyric cards, Wrapped) with other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- Home-screen widgets (4x2 and 4x1). -->
        <receiver
            android:name=".ui.widget.AalapWidgetLarge"
            android:exported="false"
            android:label="Aalap">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>
        <receiver
            android:name=".ui.widget.AalapWidgetCompact"
            android:exported="false"
            android:label="Aalap mini">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_info" />
        </receiver>

        <!-- Android Auto: declares the app as a media app for the car. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Holds the foreground for a few seconds while a background play press finds its song. -->
        <!-- Quick-settings tile: "Ask Aalap". -->
        <service
            android:name=".ui.notification.VoiceTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/ask_aalap"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- "Ask Aalap": the voice bar over any app, opened by a held volume key or its optional icon. -->
        <activity
            android:name=".di.AskAalapActivity"
            android:exported="false"
            android:label="@string/ask_aalap"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />
        <!-- Its icon, only while Profile → Voice → "Ask Aalap icon" is on (e.g. for the side key's double press). -->
        <activity-alias
            android:name=".AskAalapIcon"
            android:targetActivity=".di.AskAalapActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/ask_aalap"
            android:icon="@drawable/ic_shortcut_mic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <service
            android:name=".di.AalapKeyService"
            android:exported="false"
            android:label="@string/aalap_keys"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/aalap_keys" />
        </service>
        <service
            android:name=".di.HeyAalapService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".ui.notification.StartupService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".ui.notification.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <!-- Legacy action Android Auto uses to discover browsable media apps. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

</manifest>