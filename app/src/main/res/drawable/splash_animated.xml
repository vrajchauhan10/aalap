<?xml version="1.0" encoding="utf-8"?>
<!-- Aalap opening animation (Android 12+ splash): the replay arc sweeps round from its
     tail, its arrowhead lands, and the play button pops in. Same geometry as the icon. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group android:name="arc_group" android:pivotX="54" android:pivotY="54" android:rotation="-140">
                <path
                    android:name="arc"
                    android:pathData="M74,42 A23.3,23.3 0,1 0,76,62"
                    android:strokeColor="#FFC56B"
                    android:strokeWidth="5"
                    android:strokeLineCap="round"
                    android:trimPathStart="1"
                    android:fillColor="#00000000" />
                <path
                    android:name="arrow"
                    android:pathData="M66,30 L74,42 L64,48"
                    android:strokeColor="#FFC56B"
                    android:strokeAlpha="0"
                    android:strokeWidth="5"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:fillColor="#00000000" />
            </group>
            <group android:name="play_group" android:pivotX="54.7" android:pivotY="54" android:scaleX="0" android:scaleY="0">
                <path
                    android:pathData="M48,44 L64,54 L48,64 Z"
                    android:fillColor="#FF8A3D"
                    android:strokeColor="#FF8A3D"
                    android:strokeWidth="2"
                    android:strokeLineJoin="round" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="arc_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="-140"
                android:valueTo="0"
                android:duration="620"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="arc">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathStart"
                android:valueFrom="1"
                android:valueTo="0"
                android:duration="620"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="arrow">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:startOffset="520"
                android:duration="180"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
    <target android:name="play_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:startOffset="380"
                    android:duration="460"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:startOffset="380"
                    android:duration="460"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
