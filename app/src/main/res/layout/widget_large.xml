<?xml version="1.0" encoding="utf-8"?>
<!-- Aalap 4x2 widget. Three bands that share the widget's full height:
     track info, a live progress row, and full-width transport controls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/widget_open"
            android:scaleType="centerCrop"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_title"
                android:textColor="@color/widget_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_subtitle"
                android:textColor="@color/widget_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_like"
                android:tint="@color/widget_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/widget_like"
            android:padding="8dp"
            android:src="@drawable/ic_notif_heart" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Chronometer
            android:id="@+id/widget_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />

        <!-- Wavy progress, drawn by AalapWidgets.waveBitmap (moves while playing). -->
        <ImageView
            android:id="@+id/widget_wave"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/widget_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_prev"
                android:tint="@color/widget_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_prev"
                android:padding="9dp"
                android:src="@drawable/ic_widget_prev" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_play"
                android:tint="@color/widget_on_play"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_play_bg"
                android:contentDescription="@string/widget_play"
                android:padding="14dp"
                android:src="@drawable/ic_widget_play" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_next"
                android:tint="@color/widget_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_next"
                android:padding="9dp"
                android:src="@drawable/ic_widget_next" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
