<?xml version="1.0" encoding="utf-8"?>
<!-- Aalap small widget (2x2): plain black. Cover top-left, then the song and artist
     (one line each), and previous / play / next along the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_black"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/widget_open"
        android:scaleType="centerCrop"
        android:src="@drawable/logo" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_idle_title"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_idle_subtitle"
        android:textColor="#FFA3A3AE"
        android:textSize="12sp" />

    <!-- Takes the leftover height, so the controls sit on the bottom edge. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_prev"
            android:padding="10dp"
            android:src="@drawable/ic_widget_prev"
            android:tint="#FFE9E9EE" />

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_play_saffron"
                android:contentDescription="@string/widget_play"
                android:padding="12dp"
                android:src="@drawable/ic_widget_play"
                android:tint="#FF1A0E05" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_next"
            android:padding="10dp"
            android:src="@drawable/ic_widget_next"
            android:tint="#FFE9E9EE" />
    </LinearLayout>
</LinearLayout>
