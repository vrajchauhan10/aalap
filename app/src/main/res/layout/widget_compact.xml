<?xml version="1.0" encoding="utf-8"?>
<!-- Aalap small widget (2x2): plain black. Cover and song on top, then
     previous / play / next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_black"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/widget_open"
            android:scaleType="centerCrop"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_idle_title"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_subtitle"
                android:textColor="#FF9A9AA6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_prev"
            android:padding="8dp"
            android:src="@drawable/ic_widget_prev"
            android:tint="#FFE9E9EE" />

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_play_saffron"
                android:contentDescription="@string/widget_play"
                android:padding="11dp"
                android:src="@drawable/ic_widget_play"
                android:tint="#FF1A0E05" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_next"
            android:padding="8dp"
            android:src="@drawable/ic_widget_next"
            android:tint="#FFE9E9EE" />
    </LinearLayout>
</LinearLayout>
