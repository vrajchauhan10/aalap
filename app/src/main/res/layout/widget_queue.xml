<?xml version="1.0" encoding="utf-8"?>
<!-- Aalap 4×2 widget: the song playing with play/pause, the next two songs, and one-tap mixes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_black"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/widget_open"
            android:scaleType="centerCrop"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_title"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_subtitle"
                android:textColor="#FFA3A3AE"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="Play"
            android:padding="11dp"
            android:src="@drawable/ic_widget_play" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Next"
            android:padding="9dp"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_up1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFE9E9EE"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_up2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFA3A3AE"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_mix_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_saffron"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Aaj ka Aalap"
            android:textColor="#FF2A1405"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_mix_drive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_chip_bg"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Drive mix"
            android:textColor="#FFE9E9EE"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_mix_liked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_chip_bg"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Liked"
            android:textColor="#FFE9E9EE"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
