<?xml version="1.0" encoding="utf-8"?>
<!-- Login cookies, sessions and the Blend sign-in (and the WebView's cookie store) never leave the device. Mirrors backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="spotify_session.xml"/>
        <exclude domain="sharedpref" path="Deezer.xml"/>
        <exclude domain="sharedpref" path="SpotiflacSession.xml"/>
        <exclude domain="sharedpref" path="youtube_session.xml"/>
        <exclude domain="sharedpref" path="blend_auth.xml"/>
        <exclude domain="root" path="app_webview/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="spotify_session.xml"/>
        <exclude domain="sharedpref" path="Deezer.xml"/>
        <exclude domain="sharedpref" path="SpotiflacSession.xml"/>
        <exclude domain="sharedpref" path="youtube_session.xml"/>
        <exclude domain="sharedpref" path="blend_auth.xml"/>
        <exclude domain="root" path="app_webview/"/>
    </device-transfer>
</data-extraction-rules>
