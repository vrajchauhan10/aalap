<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the Aalap icon: "Ask Aalap" opens Aalap listening for a song, artist or mood. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="ask_aalap"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutShortLabel="@string/ask_aalap"
        android:shortcutLongLabel="@string/ask_aalap_long">
        <intent
            android:action="com.music.aalap.VOICE"
            android:targetPackage="com.music.aalap"
            android:targetClass="com.music.aalap.MainActivity" />
    </shortcut>
</shortcuts>
